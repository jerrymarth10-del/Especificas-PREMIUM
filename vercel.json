{
  "routes": [
    {
      "src": "^/lib/secretaria-escolar(?:-conteudo|-art|-access)?\\.(?:js|json)$",
      "dest": "/api/access"
    },
    {
      "src": "^/lib/cuidador-social(?:-conteudo|-art)?\\.(?:js|json)$",
      "dest": "/api/access"
    },
    {
      "src": "^/lib/terapiaocupacional(?:-conteudo)?\\.(?:js|json)$",
      "dest": "/api/access"
    },
    {
      "src": "^/$",
      "dest": "/api/inject"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/api/inject"
    },
    {
      "handle": "filesystem"
    }
  ],
  "headers": [
    {
      "source": "/prf-card.b64",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/quimica-card.b64",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|css|js)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
